{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Marshal causal blind review response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "review_id",
    "reviewer_kind",
    "decision",
    "source_induced_failure",
    "target_repairs_observed_failure",
    "assessment",
    "failure_signature",
    "uncertainties"
  ],
  "properties": {
    "review_id": {"type": "string", "pattern": "^blind-opendev-[0-9]+$"},
    "reviewer_kind": {"enum": ["human", "model"]},
    "decision": {"enum": ["accepted", "rejected", "evidence_unavailable"]},
    "source_induced_failure": {"enum": ["yes", "no", "uncertain"]},
    "target_repairs_observed_failure": {"enum": ["yes", "no", "uncertain"]},
    "assessment": {"type": "string", "minLength": 1},
    "failure_signature": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "uncertainties": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    }
  }
}
