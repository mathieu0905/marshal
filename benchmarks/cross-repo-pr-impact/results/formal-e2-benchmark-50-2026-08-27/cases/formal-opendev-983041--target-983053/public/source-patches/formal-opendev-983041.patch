diff --git a/releasenotes/notes/l3-agent-scheduler-ha-chassis-priority-a1b2c3d4e5f6.yaml b/releasenotes/notes/l3-agent-scheduler-ha-chassis-priority-a1b2c3d4e5f6.yaml
