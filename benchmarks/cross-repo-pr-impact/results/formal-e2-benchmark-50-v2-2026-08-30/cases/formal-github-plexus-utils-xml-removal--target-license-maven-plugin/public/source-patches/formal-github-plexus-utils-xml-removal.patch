-            encoding = UTF_16BE;
-            is.reset();
-            is.read();
-            is.read();
-        }
-        else if ( bytes[0] == 0xFF && bytes[1] == 0xFE )
-        {
-            encoding = UTF_16LE;
-            is.reset();
-            is.read();
-            is.read();
-        }
-        else if ( bytes[0] == 0xEF && bytes[1] == 0xBB && bytes[2] == 0xBF )
-        {
-            encoding = UTF_8;
-        }
-        else
-        {
-            is.reset();
-        }
