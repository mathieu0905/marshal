-    private static int findFragment( int bufMinPos, char[] b, int start, int end )
-    {
-        // System.err.println("bufStart="+bufStart+" b="+printable(new String(b, start, end - start))+" start="+start+"
-        // end="+end);
-        if ( start < bufMinPos )
-        {
-            start = bufMinPos;
-            if ( start > end )
-                start = end;
-            return start;
-        }
-        if ( end - start > 65 )
-        {
-            start = end - 10; // try to find good location
-        }
-        int i = start + 1;
-        while ( --i > bufMinPos )
-        {
-            if ( ( end - i ) > 65 )
-                break;
-            final char c = b[i];
-            if ( c == '<' && ( start - i ) > 10 )
-                break;
-        }
-        return i;
-    }
