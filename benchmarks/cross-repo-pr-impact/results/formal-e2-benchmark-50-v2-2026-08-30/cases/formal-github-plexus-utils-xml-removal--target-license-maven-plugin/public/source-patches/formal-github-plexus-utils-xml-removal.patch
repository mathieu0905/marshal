-            {
-                writeIndent();
-                out.write( " " );
-            }
-            if ( namespacePrefix[i] != "" )
-            {
-                out.write( " xmlns:" );
-                out.write( namespacePrefix[i] );
-                out.write( '=' );
-            }
-            else
-            {
-                out.write( " xmlns=" );
