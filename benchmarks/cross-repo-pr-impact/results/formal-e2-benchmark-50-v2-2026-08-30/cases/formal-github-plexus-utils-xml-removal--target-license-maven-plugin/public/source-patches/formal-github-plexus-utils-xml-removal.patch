-
-        try ( Reader reader = ReaderFactory.newXmlReader( f ) )
-        {
-            XmlPullParser parser = new MXParser();
-            parser.setInput( reader );
-            parser.nextToken();
-            return true;
-        }
-        catch ( Exception e )
