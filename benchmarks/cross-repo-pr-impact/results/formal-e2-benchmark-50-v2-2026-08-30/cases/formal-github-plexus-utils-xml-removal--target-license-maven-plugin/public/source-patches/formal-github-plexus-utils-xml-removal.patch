-            case '\t':
-                retval.append( "\\t" );
-                break;
-            case '\n':
-                retval.append( "\\n" );
-                break;
-            case '\f':
-                retval.append( "\\f" );
-                break;
-            case '\r':
-                retval.append( "\\r" );
-                break;
-            case '\"':
-                retval.append( "\\\"" );
-                break;
-            case '\'':
-                retval.append( "\\\'" );
-                break;
-            case '\\':
