-    private static String escapeXml( String text )
-    {
-        if ( text.indexOf( '&' ) >= 0 )
-        {
-            text = amp.matcher( text ).replaceAll( "&amp;" );
-        }
-        if ( text.indexOf( '<' ) >= 0 )
-        {
-            text = lt.matcher( text ).replaceAll( "&lt;" );
-        }
-        if ( text.indexOf( '>' ) >= 0 )
-        {
-            text = gt.matcher( text ).replaceAll( "&gt;" );
