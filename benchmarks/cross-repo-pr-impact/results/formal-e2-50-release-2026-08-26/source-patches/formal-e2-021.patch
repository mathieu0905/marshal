+[Unit]
+Description=StarlingX Pxeboot Feed Refresh
+After=config.service
+Before=pmon.service
+
+[Service]
+Type=oneshot
+RemainAfterExit=yes
+ExecStart=/etc/init.d/pxeboot_feed
+
+[Install]
+WantedBy=multi-user.target
+
diff --git a/installer/pxe-network-installer/pxe-network-installer/pxeboot_feed.sh b/installer/pxe-network-installer/pxe-network-installer/pxeboot_feed.sh
