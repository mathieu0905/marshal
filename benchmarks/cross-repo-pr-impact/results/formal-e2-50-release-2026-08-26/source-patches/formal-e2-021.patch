index 0000000..8ebad67
--- /dev/null
+++ b/installer/pxe-network-installer/pxe-network-installer/pxeboot_feed.sh
@@ -0,0 +1,170 @@
+#!/bin/bash
+#############################################################################
+# Copyright (c) 2013-2016 Wind River Systems, Inc.
+#
+# SPDX-License-Identifier: Apache-2.0
+#
+#
+# This utility is used to create or update the following directories
+#
+#    /var/www/pages/feed/rel-xx.xx/pxeboot
+#    /var/pxeboot/rel-xx.xx
+#
+# ... with the kernel, initrd and other images and signature files from /boot
+#
+#############################################################################
+#
+#
+# chkconfig: 2345 98 2
+#
+### BEGIN INIT INFO
+# Provides:          feed_refresh
+# Required-Start: $null
+# Required-Stop: $null
+# Default-Start:     3 5
+# Default-Stop:      0 1 2 6
+# Short-Description: Installer "feed refresh" script
+### END INIT INFO
+
+debug=false
+[ -n "${1}" ] && [ "${1}" == "debug" ] && debug=true
+
+LOG_TAG=${LOG_TAG:-"Feed Refresh"}
+
+RETVAL=0
+
+#############################################################################
+# Log message to syslog
+#############################################################################
+function ilog()
+{
+    local dt=''
+    dt="$(date "+%Y-%m-%d %H:%M:%S.%3N")"
+    echo "$dt info : ${1}"
+    logger -t "${LOG_TAG}" "$@"
+}
+
+function dlog()
+{
+    if [ "${debug}" == true ] ; then
+        local dt=''
+        dt="$(date "+%Y-%m-%d %H:%M:%S.%3N")"
+        echo "$dt debug: ${1}"
+        logger -t "${LOG_TAG}" "$@"
+    fi
+}
+
+# Override release with what is found in platform.conf
+rel=$(grep sw_version < /etc/platform/platform.conf | cut -d '=' -f 2)
+if [ -z "${rel}" ] ; then
+    rel="xxxSW_VERSIONxxx"
+fi
+
+# pxeboot objects path
+pxefeed="/var/www/pages/feed/rel-${rel}/pxeboot"
+pxeboot="/var/pxeboot"
+
+# ensure the deepest directories are created
+[ ! -d "${pxefeed}/EFI/BOOT" ]  && mkdir -p "${pxefeed}/EFI/BOOT"
+[ ! -d "${pxeboot}rel-${rel}" ] && mkdir -p "${pxeboot}/rel-${rel}"
+[ ! -d "${pxeboot}/EFI/BOOT" ]  && mkdir -p "${pxeboot}/EFI/BOOT"
+
+
+declare -a file_list=()
+file_list=( $(find "/boot/ostree" -name initramfs*) ) > /dev/null 2>&1
+file_list+=( $(find "/boot/ostree" -name vmlinuz*) ) > /dev/null 2>&1
+dlog "${file_list[*]}"
+for f in "${file_list[@]}" ; do
+    path_file1=""
+    filename=$( echo "${f}" | cut -d '/' -f 5)
+    dlog "File: ${filename} ... ${f}"
+    if [ "${filename}" == "initramfs.sig" ] ; then
+        path_file1="${pxeboot}/rel-${rel}/initrd.sig"
+        path_file2="${pxefeed}/initrd.sig"
+    elif [ "${filename}" == "initramfs" ] ; then
+        path_file1="${pxeboot}/rel-${rel}/initrd"
+        path_file2="${pxefeed}/initrd"
+    elif [ "${filename}" == "vmlinuz.sig" ] ; then
+        path_file1="${pxeboot}/rel-${rel}/bzImage.sig"
+        path_file2="${pxefeed}/bzImage.sig"
+    elif [ "${filename}" == "vmlinuz" ] ; then
+        path_file1="${pxeboot}/rel-${rel}/bzImage"
+        path_file2="${pxefeed}/bzImage"
+    elif [[ "${filename}" == *"rt-amd64.sig"* ]] ; then
+        path_file1="${pxeboot}/rel-${rel}/bzImage-rt.sig"
+        path_file2="${pxefeed}/bzImage-rt.sig"
+    elif [[ "${filename}" == *"rt-amd64"* ]] ; then
+        path_file1="${pxeboot}/rel-${rel}/bzImage-rt"
+        path_file2="${pxefeed}/bzImage-rt"
+    elif [[ "${filename}" == *"amd64.sig"* ]] ; then
+        path_file1="${pxeboot}/rel-${rel}/bzImage-std.sig"
+        path_file2="${pxefeed}/bzImage-std.sig"
+    elif [[ "${filename}" == *"amd64"* ]] ; then
+        path_file1="${pxeboot}/rel-${rel}/bzImage-std"
+        path_file2="${pxefeed}/bzImage-std"
+    else
+        ilog "ignoring unknown file: ${f}"
+    fi
+
+    if [ -n "${path_file1}" ] ; then
+        ilog "syncing ${f} to ${path_file1} and ${path_file2}"
+        rsync "${f}" "${path_file1}"
+        rsync "${f}" "${path_file2}"
+    else
+        ilog "${f} not found ; cannot sync"
+    fi
+done
+
+# Other image files
+# LockDown.efi  LockDown.efi.sig  bootx64.efi  grub.cfg  grub.cfg.sig  grubx64.efi  mmx64.efi
+file_list=( "$(find "/boot/ostree" -name LockDown.efi)" ) > /dev/null 2>&1
+file_list+=( "$(find "/boot/ostree" -name LockDown.efi.sig)" ) > /dev/null 2>&1
+file_list+=( "$(find "/boot/ostree" -name bootx64.efi)" ) > /dev/null 2>&1
+file_list+=( "$(find "/boot/ostree" -name grub.cfg)" ) > /dev/null 2>&1
+file_list+=( "$(find "/boot/ostree" -name grub.cfg.sig)" ) > /dev/null 2>&1
+file_list+=( "$(find "/boot/ostree" -name grubx64.efi)" ) > /dev/null 2>&1
+file_list+=( "$(find "/boot/ostree" -name mmx64.efi)" ) > /dev/null 2>&1
+dlog "${file_list[*]}"
+for f in "${file_list[@]}" ; do
+    path_file1=""
+    filename=$( echo "${f}" | cut -d '/' -f 8)
+    dlog "File: ${filename} ... ${f}"
+    if [[ "${filename}" == *"LockDown.efi.sig"* ]] ; then
+        path_file1="${pxeboot}/EFI/BOOT/LockDown.efi.sig"
+        path_file2="${pxefeed}/EFI/BOOT/LockDown.efi.sig"
+    elif [[ "${filename}" == *"LockDown.efi"* ]] ; then
+        path_file1="${pxeboot}/EFI/BOOT/LockDown.efi"
+        path_file2="${pxefeed}/EFI/BOOT/LockDown.efi"
+    elif [[ "${filename}" == *"bootx64.efi"* ]] ; then
+        path_file1="${pxeboot}/EFI/BOOT/bootx64.efi"
+        path_file2="${pxefeed}/EFI/BOOT/bootx64.efi"
+    elif [[ "${filename}" == *"grub.cfg.sig"* ]] ; then
+        path_file1="${pxeboot}/EFI/BOOT/grub.cfg.sig"
+        path_file2="${pxefeed}/EFI/BOOT/grub.cfg.sig"
+    elif [[ "${filename}" == *"grub.cfg"* ]] ; then
+        path_file1="${pxeboot}/EFI/BOOT/grub.cfg"
+        path_file2="${pxefeed}/EFI/BOOT/grub.cfg"
+    elif [[ "${filename}" == *"grubx64.efi"* ]] ; then
+        path_file1="${pxeboot}/EFI/BOOT/grubx64.efi"
+        path_file2="${pxefeed}/EFI/BOOT/grubx64.efi"
+    elif [[ "${filename}" == *"mmx64.efi"* ]] ; then
+        path_file1="${pxeboot}/EFI/BOOT/mmx64.efi"
+        path_file2="${pxefeed}/EFI/BOOT/mmx64.efi"
+    else
+        ilog "ignoring unknown file: ${f}"
+    fi
+
+    if [ -n "${path_file1}" ] ; then
+        ilog "syncing ${f} to ${path_file1} and ${path_file2}"
+        rsync "${f}" "${path_file1}"
+        rsync "${f}" "${path_file2}"
+    else
+        ilog "${f} not found ; cannot sync"
+    fi
+done
+
+# rsync efi.img file
+ilog "syncing efi.img to ${pxefeed}/../"
+rsync "${pxeboot}/efi.img" "${pxefeed}/../"
+
+exit $RETVAL
