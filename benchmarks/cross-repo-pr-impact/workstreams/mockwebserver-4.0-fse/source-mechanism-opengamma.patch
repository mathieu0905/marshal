From e2cfcb35ea52b28dc443c24760d1cf2325d60f07 Mon Sep 17 00:00:00 2001
From: Yuri Schimke <yuri@schimke.ee>
Date: Fri, 29 Mar 2019 21:54:10 +0000
Subject: [PATCH] Move OkHttp 4 onto Okio 2.2.2

This is the version-bearing subset of upstream commit
e2cfcb35ea52b28dc443c24760d1cf2325d60f07. OkHttp 4.0.0's Util static
initializer links Okio 2's Options.Companion; JavaSDK retains Okio 1.17.5.

diff --git a/build.gradle b/build.gradle
index 0cab1bb4e..eb85ef693 100644
--- a/build.gradle
+++ b/build.gradle
@@ -13,11 +13,11 @@ buildscript {
       'jnrUnixsocket': '0.22',
       'jsoup': '1.11.3',
       'junit': '4.12',
       'kotlin': '1.3.20',
       'moshi': '1.8.0',
-      'okio': '1.17.2',
+      'okio': '2.2.2',
   ]
 
   ext.deps = [
       'airline': "io.airlift:airline:${versions.airline}",
       'android': "com.google.android:android:${versions.android}",
-- 
2.43.0
