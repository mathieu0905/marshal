{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://marshal.local/schemas/cross-repo-pr-impact-prediction-v1.json",
  "title": "Cross-repository PR impact prediction",
  "type": "object",
  "additionalProperties": false,
  "required": ["case_id", "targets"],
  "properties": {
    "case_id": {"type": "string", "minLength": 1},
    "targets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["repository", "paths", "tests", "commands", "execution_result"],
        "properties": {
          "repository": {"type": "string", "minLength": 3},
          "paths": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "tests": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "commands": {"type": "array", "items": {"type": "array", "minItems": 1, "items": {"type": "string"}}},
          "execution_result": {"type": ["string", "null"], "enum": ["pass", "fail", "no_cross_repo_impact", "not_assessed", "fail_without_companion_pass_with_companion", "not_exercised_without_source_pass_with_source", null]}
        }
      }
    }
  }
}
