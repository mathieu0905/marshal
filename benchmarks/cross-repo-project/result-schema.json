{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Marshal project-level cross-repository benchmark result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "project_id",
    "case_id",
    "repository",
    "variant",
    "git_commit",
    "provider_variant",
    "execution_mode",
    "command",
    "expected",
    "actual",
    "matched",
    "duration_seconds",
    "environment",
    "log_path"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "run_id": {"type": "string", "pattern": "^[0-9]{8}T[0-9]{6}Z$"},
    "project_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "case_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "repository": {"type": "string", "pattern": "^[^/]+/[^/]+$"},
    "variant": {"enum": ["before", "after"]},
    "git_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "provider_variant": {"type": "string", "minLength": 1},
    "execution_mode": {"enum": ["released_dependency_fanout", "candidate_version_coordination"]},
    "command": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "expected": {"type": "object"},
    "actual": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "exit_code", "failure_category", "timed_out", "output_checks"],
      "properties": {
        "outcome": {"enum": ["pass", "fail"]},
        "exit_code": {"type": ["integer", "null"]},
        "failure_category": {"type": ["string", "null"]},
        "timed_out": {"type": "boolean"},
        "output_checks": {"type": "object", "additionalProperties": {"type": "boolean"}}
      }
    },
    "matched": {"type": "boolean"},
    "duration_seconds": {"type": "number", "minimum": 0},
    "environment": {"type": "object", "additionalProperties": {"type": "string"}},
    "log_path": {"type": "string", "minLength": 1}
  }
}
